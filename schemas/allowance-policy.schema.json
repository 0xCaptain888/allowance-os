{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allowance-os.dev/schemas/allowance-policy.schema.json",
  "title": "AllowancePolicy",
  "type": "object",
  "required": ["allowanceId", "subscriber", "merchant", "token", "perCharge", "period", "periodCap", "expiresAt", "allowedProgram", "appReleaseHash"],
  "properties": {
    "allowanceId": { "type": "string", "minLength": 1 },
    "subscriber": { "type": "string", "minLength": 1 },
    "merchant": { "type": "string", "minLength": 1 },
    "merchantName": { "type": "string" },
    "token": { "enum": ["USDC", "SKR"] },
    "perCharge": { "type": "number", "exclusiveMinimum": 0 },
    "period": { "enum": ["daily", "weekly", "monthly"] },
    "periodCap": { "type": "number", "exclusiveMinimum": 0 },
    "spentInPeriod": { "type": "number", "minimum": 0 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "allowedProgram": { "type": "string", "minLength": 1 },
    "appReleaseHash": { "type": "string", "minLength": 1 },
    "revoked": { "type": "boolean" }
  }
}
