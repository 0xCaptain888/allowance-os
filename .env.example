# Reserved for the Solana adapter. Never commit wallet secrets.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Delegated Settlement v2 runner. Use only after a v2 Program is deployed.
# Keep keypair files outside the repository and never paste their contents here.
DELEGATED_PROGRAM_ID=
SOLANA_KEYPAIR=/absolute/path/to/authority-devnet-keypair.json
EXECUTOR_KEYPAIR=/absolute/path/to/executor-devnet-keypair.json
VERIFIER_KEYPAIR=/absolute/path/to/verifier-devnet-keypair.json
TOKEN_MINT=
SOURCE_TOKEN_ACCOUNT=
MERCHANT=
MERCHANT_TOKEN_ACCOUNT=
PER_CHARGE_RAW=2000000
PERIOD_CAP_RAW=8000000
LIFETIME_CAP_RAW=24000000
CHARGE_AMOUNT_RAW=1000000
PERIOD_SECONDS=604800
