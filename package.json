{
  "name": "allowance-os",
  "version": "0.11.0",
  "private": true,
  "description": "A Solana Mobile payment-authorization layer for Web3 services, subscriptions, agents, and metered APIs.",
  "type": "module",
  "scripts": {
    "demo": "tsx src/demo.ts",
    "demo:alphabrief": "tsx examples/alphabrief/integration.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "serve:site": "node scripts/serve-site.mjs",
    "preflight": "node scripts/preflight.mjs",
    "devnet:live": "tsx scripts/run-live-devnet.ts",
    "devnet:delegated": "tsx scripts/run-delegated-devnet.ts",
    "android:test": "cd mobile/android && ./gradlew testDebugUnitTest",
    "android:build": "cd mobile/android && ./gradlew testDebugUnitTest assembleDebug",
    "android:release": "node scripts/build-production-android.mjs"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "undici": "^8.10.2"
  },
  "overrides": {
    "stream-json": "3.6.0",
    "uuid": "11.1.1"
  }
}
